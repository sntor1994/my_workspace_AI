# ==========================================================
# 外部連携用 認証設定テンプレート
# このファイルをコピーして `.env` を作成し、実際の値を設定してください。
# ※ .env は .gitignore に登録されており、Gitにはコミットされません。
# ==========================================================

# 1. Bitbucket 設定 (App Password または 個人アクセストークン)
BITBUCKET_WORKSPACE=my-company-workspace
BITBUCKET_USERNAME=your-username
BITBUCKET_APP_PASSWORD=your-bitbucket-app-password

# 2. Microsoft 365 (Outlook / Teams / Graph API)
# Azure AD アプリ登録を行って取得したClient ID等を使用する場合
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id
M365_CLIENT_SECRET=your-client-secret

# 3. ユーザー識別名 (トリアージ時のメンション判定用)
MY_DISPLAY_NAME=Your Name
MY_EMAIL=your.email@company.com
